# Ghostty config — migrated from Terminal.app "polarized" profile (2026-06-17)
# Edit and run `ghostty +validate-config` to check syntax. Reload in-app with cmd+shift+,

# --- Font (Terminal: Menlo-Regular, 11pt) ---
font-family = Menlo
font-size = 11

# --- Core colors ---
background = #000C10
foreground = #839496
cursor-color = #D33682
selection-background = #053641
# Terminal "UseBrightBold" -> bold text uses the bright palette
bold-is-bright = true

# --- ANSI palette (Solarized-style, from Terminal profile) ---
palette = 0=#053641
palette = 1=#D30002
palette = 2=#859900
palette = 3=#B58900
palette = 4=#268BD2
palette = 5=#D33682
palette = 6=#2AA198
palette = 7=#EEE8D5
palette = 8=#002B36
palette = 9=#CB4B16
palette = 10=#586E75
palette = 11=#657B83
palette = 12=#839496
palette = 13=#6C71C4
palette = 14=#FF80FF
palette = 15=#FDF6E3

# --- Window / behavior ---
# Terminal had no audible or visual bell
# (Ghostty is silent by default; nothing to set)

# Initial window size, in grid cells (Terminal saved 55 rows; 260 cols was a
# maximized wide-screen frame — trimmed to a saner default. Adjust to taste.)
window-height = 55
window-width = 200
